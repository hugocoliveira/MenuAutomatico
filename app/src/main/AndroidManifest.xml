<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissão de internet para chamadas ao SAP OData -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Permissão para verificar conectividade antes de sincronizar -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Necessário no Android 11+ para que o launcher consiga ver e lançar apps externos -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!--
        TROCA DE ÍCONE DO APP — altere android:icon e android:roundIcon abaixo:
        OPÇÃO 1 - Coletor Zebra: android:icon="@mipmap/icone"       android:roundIcon="@mipmap/icone_round"
        OPÇÃO 2 - Empilhadeira:  android:icon="@mipmap/icone_emp"   android:roundIcon="@mipmap/icone_emp_round"
    -->
    <application
        android:name=".MenuAutoApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/icone_emp"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/icone_emp_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AplicacaoMenuAutomatico"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!--
            Desabilita a inicialização automática do WorkManager para que o
            HiltWorkerFactory possa injetar dependências nos Workers (@HiltWorker).
            Sem isso, o WorkManager inicializa antes do Hilt e os @Inject nos Workers falham.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AplicacaoMenuAutomatico">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
